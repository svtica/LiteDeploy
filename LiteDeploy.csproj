<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SDK-style project, still .NET Framework 4.8 (see docs/dotnet-migration.md).
    Kept equivalent to the former project format:
    - explicit file lists (EnableDefaultItems=false) and the existing
      Properties\AssemblyInfo.cs (GenerateAssemblyInfo=false);
    - no implicit NETFRAMEWORK/NET48 defines, resources named from DependentUpon.
    64-bit only (no 32-bit build any more): one platform, output in bin\<Configuration>\
    with no platform, target framework or runtime identifier sub-folder.
    Build: msbuild LiteDeploy.sln -restore /p:Configuration=Release
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LiteDeploy</RootNamespace>
    <AssemblyName>LiteDeploy</AssemblyName>
    <ProjectGuid>{97373B40-789C-481E-A62A-A59DA56CCC60}</ProjectGuid>
    <!-- One platform (AnyCPU) so the output has no platform folder; the exe runs as 64-bit -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <FileAlignment>512</FileAlignment>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DisableImplicitFrameworkDefines>true</DisableImplicitFrameworkDefines>
    <!-- Same compiler inputs and outputs as the former project format: no implicit
         RELEASE/DEBUG define, no implicit framework references, app.config copied as is -->
    <DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
