<Project Sdk="Microsoft.NET.Sdk">
  <!--
    LiteDeploy.Worker.exe: runs on the target computer, as SYSTEM, copied there by PsExec (-s -c).
    Stand-alone on purpose: PsExec copies the exe only. Shared code is compiled in from Shared\;
    LiteSuite.Common.dll (NuGet package) is embedded as a resource and loaded from it
    (Program.ResolveEmbeddedAssembly), so the worker is still a single file.
    Its results go to standard output (WorkerProtocol), read by LiteDeploy.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>LiteDeploy.Worker</RootNamespace>
    <AssemblyName>LiteDeploy.Worker</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <Version>1.0.0</Version>
    <Product>LiteDeploy</Product>
    <Description>LiteDeploy software update worker (runs on the target computer as SYSTEM).</Description>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <!-- Signature check of the update modules (AuthenticodeVerifier, UpdateSignaturePolicy) -->
    <PackageReference Include="LiteSuite.Common" Version="1.0.1" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- The signed DLL of the package, embedded: the worker stays a single file for PsExec -c -->
    <EmbeddedResource Include="$(PkgLiteSuite_Common)\lib\net48\LiteSuite.Common.dll" LogicalName="LiteSuite.Common.dll" Visible="false" />
  </ItemGroup>
</Project>
