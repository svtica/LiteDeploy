<Project Sdk="Microsoft.NET.Sdk">
  <!--
    LiteDeploy.Worker.exe: runs on the target computer, as SYSTEM, copied there by PsExec (-s -c).
    Stand-alone on purpose: PsExec copies the exe only, so it references nothing outside the
    .NET Framework (shared code is compiled in from Shared\ and from LiteSuite.Common sources).
    Its results go to standard output (WorkerProtocol), read by LiteDeploy.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>LiteDeploy.Worker</RootNamespace>
    <AssemblyName>LiteDeploy.Worker</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <Version>1.0.0</Version>
    <Product>LiteDeploy</Product>
    <Description>LiteDeploy software update worker (runs on the target computer as SYSTEM).</Description>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
