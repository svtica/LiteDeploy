<Project Sdk="Microsoft.NET.Sdk">
  <!--
    LiteSuite.Common: components shared by the LiteSuite tools (LiteDeploy, LiteTask).
    Pure logic and small Win32 wrappers with no dependency on the application that uses them.
    Built for .NET Framework 4.8 (LiteDeploy) and .NET 10 (LiteTask, and LiteDeploy after its
    migration). Lives in the LiteDeploy repository until LiteTask adopts it, then moves to its own
    repository.
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>LiteSuite</RootNamespace>
    <AssemblyName>LiteSuite.Common</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Product>LiteSuite</Product>
    <Description>Components shared by the LiteSuite tools.</Description>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
